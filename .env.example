# Copiez ces trois variables dans Vercel > Project Settings > Environment Variables.
# Ne publiez jamais le fichier .env sur GitHub.

# Base PostgreSQL distante et persistante (Neon gratuit recommandé).
# Ajoutez ?sslmode=require si votre fournisseur le demande.
DATABASE_URL="postgresql://utilisateur:mot_de_passe@hote/neondb?sslmode=require"

# Mot de passe de l'espace /admin (au moins 8 caractères, de préférence une phrase longue).
ADMIN_PASSWORD="changez-moi-avant-la-publication"

# Clé de signature des sessions : par exemple `openssl rand -hex 32`
ADMIN_SESSION_SECRET="cle-aleatoire-d-au-moins-24-caracteres"
